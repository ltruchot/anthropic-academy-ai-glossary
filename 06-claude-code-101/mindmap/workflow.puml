@startuml workflow
' Rendered with PlantUML, smetana layout (no Graphviz needed).
!pragma layout smetana

skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam roundCorner 12
skinparam ArrowColor #555555
skinparam rectangle {
  BorderColor #FFFFFF
  FontSize 15
}
<style>
rectangle {
  MinimumWidth 230
}
</style>

title The Explore, Plan, Code, Commit workflow\n<size:12><color:#777>Le flux de travail Explore, Plan, Code, Commit</color></size>

rectangle "**Explore, Plan, Code, Commit workflow**\n<size:11><color:#777>Flux de travail Explore, Plan, Code, Commit</color></size>\nThe one thing to take away from the course\n<size:11><color:#777>La seule chose à retenir de ce cours</color></size>\nWithout it: straight to code, and more course-correcting later\n<size:11><color:#777>Sans lui : directement au code, et davantage d'ajustements en cours de route</color></size>" as WHY #CFCBDD
rectangle "**Plan mode: the fastest way to handle the first two steps**\n<size:11><color:#777>Mode Plan : la façon la plus rapide de traiter les deux premières étapes</color></size>" as PM #F9F8F4 {
  rectangle "**Explore**\n<size:11><color:#777>Explore</color></size>\nGives Claude the relevant context it needs for your project\n<size:11><color:#777>Donne à Claude le contexte pertinent dont il a besoin pour votre projet</color></size>" as E #BCD3CB
  rectangle "**Plan**\n<size:11><color:#777>Plan</color></size>\nCreates a plan of action that Claude uses to measure success\n<size:11><color:#777>Crée un plan d'action que Claude utilise pour mesurer sa réussite</color></size>\nReviewing it: the best place to course-correct, before any code is written\n<size:11><color:#777>Sa relecture : le meilleur moment pour ajuster, avant que du code soit écrit</color></size>" as PL #BCD3CB
}
rectangle "**Code**\n<size:11><color:#777>Code</color></size>\nThe back and forth between you and Claude\n<size:11><color:#777>Le va-et-vient entre vous et Claude</color></size>\nDefine a success criteria, add tools, include a test suite\n<size:11><color:#777>Définissez des critères de réussite, ajoutez des outils, fournissez une suite de tests</color></size>" as CO #BCD3CB
rectangle "**Commit**\n<size:11><color:#777>Commit</color></size>\nHelps you review and push your code\n<size:11><color:#777>Vous aide à relire et à pousser votre code</color></size>\nFirst test the changes yourself, then run a subagent code reviewer\n<size:11><color:#777>D'abord tester vous-même les changements, puis lancer un sous-agent relecteur de code</color></size>\nThen a commit message in your style, generated by Claude\n<size:11><color:#777>Puis un message de commit dans votre style, généré par Claude</color></size>" as CM #BCD3CB
rectangle "**Code review**\n<size:11><color:#777>Revue de code</color></size>\n/diff: read the actual diff before you trust the summary alone\n<size:11><color:#777>/diff : lisez le diff réel avant de vous fier au seul résumé</color></size>\n/code-review: a second reviewer, in a clean context; it reports, it edits nothing\n<size:11><color:#777>/code-review : un second relecteur, dans un contexte vierge ; il signale, il ne modifie rien</color></size>\nEach finding: Fix now, Ask why, or Leave it\n<size:11><color:#777>Chaque constat : « Corriger maintenant », « Demander pourquoi » ou « Laisser tel quel »</color></size>\n/rewind: if the whole change is wrong\n<size:11><color:#777>/rewind : si tout le changement est mauvais</color></size>" as REV #E8E2D0

' The four steps in the course's order; the review of lesson 7 sits before a change is kept.
' Explore and Plan sit inside plan mode; Commit loops back to Explore for the next feature.
WHY --> PM
E --> PL
PL --> CO
CO --> CM
CM --> E : rinse and repeat\n<size:11><color:#777>puis on recommence</color></size>
CO --> REV : before keeping a change\n<size:11><color:#777>avant de conserver un changement</color></size>

@enduml
